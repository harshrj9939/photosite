# Generate a long random value before deployment. Do not commit your real .env file.
FLASK_SECRET_KEY=replace-with-a-long-random-value
PORT=5000

# Admin dashboard login — change both before launching.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional: enable secure online payments with Razorpay.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxx
