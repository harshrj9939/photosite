# Generate a long random value before deployment. Do not commit your real .env file.
FLASK_SECRET_KEY=replace-with-a-long-random-value
PORT=5000
# Change to true after your HTTPS domain is live.
SESSION_COOKIE_SECURE=false

# Admin dashboard login — change both before launching.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# Optional: enable secure online payments with Razorpay.
# RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxx

# New-order notification email. Gmail users should create an App Password
# (not use their normal Gmail password) and turn on 2-Step Verification first.
NOTIFICATION_EMAIL=you@yourbusiness.com
SMTP_FROM_EMAIL=you@yourbusiness.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=you@yourbusiness.com
SMTP_PASSWORD=your-16-character-gmail-app-password
